# Copiar a `.env` y completar. NUNCA commitear el `.env` real.

# Postgres. Formato SQLAlchemy (driver psycopg2 sincrono).
DATABASE_URL=postgresql+psycopg2://cotejo:cotejo@localhost:5432/cotejo

# Broker/backend de Celery. Todavia no se usa (los jobs de ingesta son una tarea aparte),
# queda declarado para que el worker lo tome sin cambiar config.
REDIS_URL=redis://localhost:6379/0

# App
COTEJO_ENV=local
LOG_LEVEL=INFO
SQL_ECHO=false

# CORS del frontend Next.js (lista separada por comas)
CORS_ORIGINS=http://localhost:3000

# Cuentas de usuario / sesion. La sesion es un token opaco (aleatorio) guardado hasheado
# en la tabla `user_session`, no un JWT: por eso NO hay ningun secreto de firma que
# configurar aca, solo el nombre de la cookie y por cuantos dias vive.
SESSION_COOKIE_NAME=cotejo_session
SESSION_TTL_DAYS=30

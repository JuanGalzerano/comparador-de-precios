# Copiar a `.env` y completar. NUNCA commitear el `.env` real.

# Base de datos. El default del codigo es SQLite (`sqlite+pysqlite:///./dev.db`), que
# alcanza para desarrollo local. En produccion, Postgres:
DATABASE_URL=postgresql+psycopg2://cotejo:cotejo@localhost:5432/cotejo

# Broker/backend de Celery. Todavia no se usa (los jobs de ingesta son una tarea aparte),
# queda declarado para que el worker lo tome sin cambiar config.
REDIS_URL=redis://localhost:6379/0

# App. `COTEJO_ENV` distinto de local/dev/test activa la cookie `Secure` y hace que la
# app avise por log si `DATABASE_URL` sigue apuntando a SQLite.
COTEJO_ENV=local
LOG_LEVEL=INFO
SQL_ECHO=false

# CORS del frontend Next.js. Se aceptan las dos formas:
#   CORS_ORIGINS=http://localhost:3000,https://cotejo.ar
#   CORS_ORIGINS=["http://localhost:3000","https://cotejo.ar"]
# En produccion tiene que incluir la URL REAL del frontend (la de Vercel tambien, no solo
# el dominio propio): el grafico de historial de precios pega al backend desde el browser
# y sin CORS desaparece en silencio.
CORS_ORIGINS=http://localhost:3000

# Cuentas de usuario / sesion. La sesion es un token opaco (aleatorio) guardado hasheado
# en la tabla `user_session`, no un JWT: por eso NO hay ningun secreto de firma que
# configurar aca, solo el nombre de la cookie y por cuantos dias vive.
SESSION_COOKIE_NAME=cotejo_session
SESSION_TTL_DAYS=30

# MercadoLibre: la API publica pasa a requerir OAuth. Sin esto responde 403 a todo.
# Ver MERCADOLIBRE_API.md para obtener el token (dura 6 horas).
# ML_ACCESS_TOKEN=APP_USR-xxxxxxxx

# Cuota de tu plan de base de datos, en MB. De aca salen los umbrales del cache:
# al 75% se borra lo frio, al 90% se deja de guardar y se sirve todo en vivo.
# AJUSTAR segun el plan que contrates:
#   Neon free ......... 512     Neon Launch ....... 10240
#   Supabase free ..... 500     Supabase Pro ...... 8192
#   Railway Postgres .. lo que tengas asignado en el volumen
# Si lo dejas mas alto que la cuota real, la base se llena antes de que el freno actue.
STORAGE_QUOTA_MB=512

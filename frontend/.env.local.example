# URL base de la API de Cotejo (backend/, FastAPI). Nunca hardcodeada en el
# codigo: se lee via process.env.NEXT_PUBLIC_API_URL (ver lib/config.ts).
# El prefijo NEXT_PUBLIC_ es necesario porque las paginas la usan tanto desde
# Server Components (fetch en el servidor) como, potencialmente, desde
# codigo de cliente mas adelante.
#
# Copiar a .env.local (gitignoreado) y ajustar segun el entorno:
NEXT_PUBLIC_API_URL=http://localhost:8000

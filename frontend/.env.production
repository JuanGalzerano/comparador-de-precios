# Variables de build para producción. `NEXT_PUBLIC_*` se incrusta en el bundle que
# recibe el navegador, así que NO son secretos — son URLs públicas y va bien commitearlas.
#
# OJO: Next las congela en tiempo de build. Cambiar esto exige rebuildear el frontend;
# no alcanza con reiniciarlo.

# Backend en Railway.
NEXT_PUBLIC_API_URL=https://comparador-de-precios-production.up.railway.app

# URL pública del sitio. La usa el sitemap y los metadatos para compartir.
# Se completa después del primer deploy, cuando Cloudflare asigne el dominio.
NEXT_PUBLIC_SITE_URL=https://cotejo.workers.dev
